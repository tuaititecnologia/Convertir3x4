; Configuración del catálogo para una PC. Copiar como "catalogo.ini" junto a
; Convertir3x4.exe (o en la carpeta de datos de la app) y completar la clave.
; NUNCA subir catalogo.ini al repositorio: tiene la contraseña de la base.

[catalogo]
; Servidor PostgreSQL del catálogo (la App «catalogo» de TrueNAS). Por IP: el
; nombre del NAS no siempre resuelve (sin mDNS) y para la base da lo mismo.
; Desde afuera de la iglesia, por Netbird: 100.118.161.236.
servidor = 192.168.1.224
puerto = 5432
base = catalogo
usuario = catalogo
clave =

; Raíz del recurso compartido. Siempre por nombre, no por IP ni letra de
; unidad: ProPresenter guarda la ruta completa que recibe al arrastrar.
raiz = \\truenas\multimedia

; Las carpetas que se catalogan no van acá: se manejan desde la app (⚙ de
; Catalogar) y quedan en el catálogo. Un «carpetas =» de antes se ignora.
